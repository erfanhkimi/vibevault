{
  "manifest_version": 3,
  "name": "VibeVault - Visual Context Bookmarks",
  "version": "1.0.0",
  "description": "Save the vibe. Remember why.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "tabs"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Save to VibeVault"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  }
}